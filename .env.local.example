# Copiá este archivo como .env.local y completá con los valores de tu proyecto Supabase.
# (Supabase → Project Settings → API)

# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el browser, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA, solo servidor, saltea RLS). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── ARCA / AFIP (facturación electrónica) ───────────────────────────────────
# Entorno: 'homologacion' (pruebas, default) o 'produccion'. Arrancar en homologación.
ARCA_ENV=homologacion
# CUIT del emisor (con o sin guiones).
ARCA_CUIT=
# Punto de venta habilitado para Web Services.
ARCA_PTO_VENTA=
# Certificado .pem (contenido COMPLETO, multilínea, incluyendo las líneas BEGIN/END).
# En Vercel se pega tal cual (respeta los saltos de línea). SECRETO: no commitear.
ARCA_CERT=
# Clave privada .pem (contenido COMPLETO, multilínea). SECRETO: no commitear jamás.
ARCA_KEY=
